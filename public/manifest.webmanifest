{
  "name": "MyBudget",
  "short_name": "MyBudget",
  "description": "Track expenses and income, savings goals and monthly budgets.",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0E0D0C",
  "theme_color": "#0E0D0C",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/detections",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Add a transaction", "url": "/transactions/new", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Detected transactions", "url": "/detections", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
